# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.
# En Render, estas mismas variables van en el servicio web: Environment -> Environment Variables.

# Base de datos PostgreSQL de Render (Dashboard -> tu base -> Connections).
# - En tu computadora: "External Database URL".
# - En el servicio web de Render: "Internal Database URL" (más rápida y sin salir a internet).
DATABASE_URL=

# Clave para firmar las sesiones de empleados. Una cadena larga y aleatoria; genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Administrador inicial: se crea al arrancar solo si todavía no existe ningún admin.
# Después de entrar por primera vez, cambia la contraseña desde "Mi cuenta" en el panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (modo prueba): dashboard.stripe.com -> Developers -> API keys -> Secret key (sk_test_...)
STRIPE_SECRET_KEY=
# Solo si configuras el webhook (stripe listen ... o Dashboard -> Webhooks)
STRIPE_WEBHOOK_SECRET=

# URL de la tienda (sin / al final). Stripe regresa ahí después de pagar, y CORS solo acepta esa página.
# En local: http://localhost:5173. Déjala vacía para aceptar peticiones de cualquier origen.
FRONTEND_URL=
